{
  "name": "opencode-delete-messages",
  "version": "1.0.1",
  "description": "OpenCode TUI plugin: delete the last assistant message of the current session without reverting file changes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fede-ciliberti/opencode-delete-messages.git"
  },
  "type": "module",
  "exports": {
    "./tui": {
      "import": "./dist/tui.js",
      "types": "./dist/tui.d.ts"
    }
  },
  "engines": {
    "opencode": ">=1.18.0"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "pretest": "npm run build",
    "test": "bun test",
    "prepack": "npm run build"
  },
  "keywords": ["opencode", "opencode-plugin", "opencode-tui", "tui"],
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.32",
    "@opencode-ai/sdk": "1.18.32",
    "typescript": "5.9.3",
    "@types/bun": "1.3.2"
  }
}
